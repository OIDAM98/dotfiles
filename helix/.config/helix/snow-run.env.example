# Per-machine settings for snow-run.sh (the Helix `space n` Snowflake menu).
#
# Setup on a new machine:
#   mkdir -p ~/.config/snow-run
#   cp ~/.config/helix/snow-run.env.example ~/.config/snow-run/env
#   then edit ~/.config/snow-run/env
#
# ~/.config/snow-run/env is NOT in dotfiles and is git-ignored. Every variable is
# optional: anything left empty or commented out is not passed to `snow`, which
# then uses the default connection in ~/.snowflake/connections.toml.

# Connection name from ~/.snowflake/connections.toml (empty = the default one)
#SNOW_RUN_CONNECTION=

# Role to run as (empty = the connection's role)
#SNOW_RUN_ROLE=

# Warehouse to use (empty = the connection's warehouse)
#SNOW_RUN_WAREHOUSE=
