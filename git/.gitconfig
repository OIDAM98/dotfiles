# Default identity: personal. Work identities are applied per directory (includeIf below).
[user]
	name = Oscar De Alva
	email = oscar.ivan98@gmail.com

[core]
	editor = hx
	pager = delta
	sshCommand = ssh -i ~/.ssh/personal -o IdentitiesOnly=yes

[init]
	defaultBranch = main

[alias]
	logline = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

# Per-directory identities. Trailing "/" matters: it matches every repo below the directory.
# These files live outside this repo and set user.name, user.email and core.sshCommand.
[includeIf "gitdir:~/Documents/FEMSA/"]
	path = ~/Documents/FEMSA/.gitconfig-work

[includeIf "gitdir:~/Documents/REALTOR/"]
	path = ~/Documents/REALTOR/.gitconfig-realtor

# Machine-local settings (not versioned), e.g. the Zscaler CA cert on the work laptop.
[include]
	path = ~/.gitconfig-local

[include]
	path = ~/.nc-os/gitconfig
