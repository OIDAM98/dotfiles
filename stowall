#!/usr/bin/env bash
# Symlink every package in this repo into $HOME with GNU Stow.
#
# Usage: ./stowall [-n|--dry-run] [--adopt] [package ...]
#   -n, --dry-run   show what would be linked, change nothing
#   --adopt         if a real file already exists where a link should go, MOVE it into the
#                   repo (overwriting the repo copy). Off by default: on a new machine it would
#                   replace your configs with the defaults. Review with `git diff` afterwards.
#   package ...     only these packages (default: every top-level folder except examples/)
#
# Without --adopt, a real file in the way is reported as a conflict and left alone: move or
# delete it, then re-run.

set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="${HOME}"
EXCLUDE=("examples")

dry_run=0
adopt=0
packages=()

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry_run=1 ;;
    --adopt) adopt=1 ;;
    -h|--help) sed -n '2,13p' "${BASH_SOURCE[0]}"; exit 0 ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) packages+=("$1") ;;
  esac
  shift
done

command -v stow >/dev/null 2>&1 || { echo "stow is not installed (brew install stow / sudo apt install stow)" >&2; exit 1; }

if [ ${#packages[@]} -eq 0 ]; then
  for d in "${DOTFILES}"/*/; do
    name="$(basename "$d")"
    skip=0
    for ex in "${EXCLUDE[@]}"; do [ "$name" = "$ex" ] && skip=1; done
    [ "$skip" -eq 0 ] && packages+=("$name")
  done
fi

if [ "$adopt" -eq 1 ] && [ "$dry_run" -eq 0 ]; then
  echo "--adopt will move existing files from \$HOME into the repo, overwriting repo copies."
  read -r -p "Continue? [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 1; }
fi

args=(-d "$DOTFILES" -t "$TARGET" --no-folding --restow -v)
[ "$dry_run" -eq 1 ] && args+=(-n)
[ "$adopt" -eq 1 ] && args+=(--adopt)

failed=()
for pkg in "${packages[@]}"; do
  if [ ! -d "${DOTFILES}/${pkg}" ]; then
    echo "!! ${pkg}: no such package" >&2
    failed+=("$pkg")
    continue
  fi
  echo "== ${pkg} =="
  if ! stow "${args[@]}" "$pkg"; then
    failed+=("$pkg")
  fi
done

echo "---"
if [ ${#failed[@]} -gt 0 ]; then
  echo "Conflicts or errors in: ${failed[*]}" >&2
  echo "Fix them (move the existing files away) and re-run, or use --adopt to pull them into the repo." >&2
  exit 1
fi
[ "$dry_run" -eq 1 ] && echo "Dry run OK, nothing changed." || echo "All packages stowed."
